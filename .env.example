KALSHI_ENV=prod
KALSHI_REST_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
KALSHI_KEY_ID=...
KALSHI_PRIVATE_KEY_PATH=...
LIVE_TRADING=false

BOT_MODE=weather
CITIES=NYC,LA,CHI

REFRESH_SECONDS=20
NO_TRADE_WINDOW_SECONDS=21600
EXIT_ONLY_WINDOW_SECONDS=10800

MIN_SPREAD_CENTS=6
MIN_24H_VOLUME=500
MAX_MARKETS=8

START_BANKROLL_DOLLARS=1400
MAX_GROSS_EXPOSURE_DOLLARS=250
MAX_NET_EXPOSURE_DOLLARS=150
MAX_EXPOSURE_PER_CITY_DOLLARS=125
MAX_EXPOSURE_PER_MARKET_DOLLARS=75
MAX_ORDER_SIZE_CONTRACTS=10

MIN_EV_DOLLARS_PER_CONTRACT=0.02
TAKE_PROFIT_CENTS=4
STOP_LOSS_CENTS=6

FORECAST_STALE_MINUTES_SAME_DAY=30
FORECAST_STALE_MINUTES_NEXT_DAY=180

DAILY_STOP_LOSS_DOLLARS=50
DAILY_TAKE_PROFIT_DOLLARS=40

MAKER_ONLY=true
SQLITE_PATH=weather_bot.db
LOG_LEVEL=INFO

SIGMA_SAME_DAY=1.25
SIGMA_NEXT_DAY=2.0
SIGMA_TWO_PLUS_DAY=2.8
